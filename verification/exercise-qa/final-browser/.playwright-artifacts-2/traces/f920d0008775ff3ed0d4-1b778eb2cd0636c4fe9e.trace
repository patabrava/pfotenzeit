roll-key":"lesson-dock"},["DIV",{"class":"dock-main"},["BUTTON",{"class":"btn btn--primary btn--large btn--block","type":"button","data-key":"next"},["SPAN",{"class":"btn-label"},"Weiter"]]],["BUTTON",{"class":"btn btn--secondary btn--icon","type":"button","aria-label":"Menü","data-key":"more"},["SPAN",{"class":"btn-icon","aria-hidden":"true"},["svg",{"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round"},["path",{"d":"M6 12h.01M12 12h.01M18 12h.01"}]]]]]]],[[150,37]],[[150,38]],[[217,54]],[[150,39]],[[217,57]]]],[[219,28]],[[219,29]]]],"viewport":{"width":360,"height":640},"timestamp":89015.523,"wallTime":1791648224488,"collectionTime":0.30000001192092896,"resourceOverrides":[],"isMainFrame":true}}
{"type":"before","callId":"ipwl@473","startTime":89016.318,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => new Promise((resolve, reject) => {\n    const request = indexedDB.open('pfotenzeit');\n    request.onerror = () => reject(request.error);\n    request.onsuccess = () => {\n      const db = request.result;\n      const transaction = db.transaction(['meta', 'saves']);\n      let meta, saves;\n      transaction.objectStore('meta').get('meta').onsuccess = event => {\n        meta = event.target.result;\n      };\n      transaction.objectStore('saves').getAll().onsuccess = event => {\n        saves = event.target.result;\n      };\n      transaction.oncomplete = () => {\n        db.close();\n        resolve(saves.find(s => s.saveId === meta.saveIds[meta.activeMode]));\n      };\n      transaction.onerror = () => {\n        db.close();\n        reject(transaction.error);\n      };\n    };\n  })","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
