{"type":"before","callId":"ipwl@455","startTime":87587.383,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => new Promise((resolve, reject) => {\n    const request = indexedDB.open('pfotenzeit');\n    request.onerror = () => reject(request.error);\n    request.onsuccess = () => {\n      const db = request.result;\n      const transaction = db.transaction(['meta', 'saves']);\n      let meta, saves;\n      transaction.objectStore('meta').get('meta').onsuccess = event => {\n        meta = event.target.result;\n      };\n      transaction.objectStore('saves').getAll().onsuccess = event => {\n        saves = event.target.result;\n      };\n      transaction.oncomplete = () => {\n        db.close();\n        resolve(saves.find(s => s.saveId === meta.saveIds[meta.activeMode]));\n      };\n      transaction.onerror = () => {\n        db.close();\n        reject(transaction.error);\n      };\n    };\n  })","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
