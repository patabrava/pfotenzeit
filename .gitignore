# Vendor asset evaluation: purchased originals and raw exports never enter the public repo (D-036)
art/vendor-evaluation/*/*/original/
art/vendor-evaluation/*/*/export/
art/vendor-evaluation/**/*.zip
art/vendor-evaluation/**/*.rar
art/vendor-evaluation/**/*.7z

# Vendor dry run (WP-L): inputs and negative-case GLBs are regenerated by scripts/dev/make-vendor-dryrun.mjs
art/staging/vendor-dryrun/input/
art/staging/vendor-dryrun/expect-fail/**/*.glb
