{
  "name": "pfotenzeit",
  "private": true,
  "version": "0.1.0",
  "description": "Pfotenzeit – mobile-first Hundeschul-Prototyp (plain Three.js + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test:e2e": "playwright test",
    "assets:build": "node scripts/build-models.mjs",
    "assets:check": "node scripts/validate-assets.mjs",
    "pixel:export": "node scripts/export-pixel.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/three": "0.186.0",
    "fake-indexeddb": "6.2.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "happy-dom": "20.14.6",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
